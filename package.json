{
	"name": "tile-browser",
	"version": "1.0.0",
	"description": "Navigateur internet multi-tuiles avec assistant IA local connecté à Ollama.",
	"main": "main.js",
	"scripts": {
	"start": "electron .",
	"dist": "electron-builder --windows nsis:x64"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"dependencies": {
	"react": "^19.2.8",
	"react-dom": "^19.2.8",
	"react-mosaic-component": "^7.0.0",
	"typescript": "^5.9.2"
	},
	"devDependencies": {
	"electron": "^44.7.0",
	"electron-builder": "^26.15.3"
	},
	"build": {
	  "appId": "com.harebrowser.app",
	  "productName": "Hare Browser",
	  "win": {
		"target": "nsis",
		"icon": "build/icon.ico"
	  },
	  "nsis": {
		"oneClick": false,
		"allowToChangeInstallationDirectory": true,
		"createDesktopShortcut": true,
		"createStartMenuShortcut": true,
		"shortcutName": "Hare Browser"
	  },
	  "extraResources": [
		{
		  "from": "bin/${platform}/${arch}",
		  "to": "ollama-bin",
		  "filter": ["*"]
		}
	  ],
	  "files": [
		"**/*",
		"!out/**/*",
		"!dist/**/*",
		"!bin/**/*"
	  ]
	}
 }
