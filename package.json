{
  "name": "hare-browser",
  "version": "1.0.2",
  "description": "Multi-tile web browser with a local AI assistant powered by Ollama.",
  "main": "main.js",
  "license": "MIT",
  "author": "Richard Clermont",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --windows nsis:x64",
    "dist:web": "electron-builder --windows nsis-web:x64",
    "dist:store": "electron-builder --win appx --x64"
  },
  "keywords": [],
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "follow-redirects": "^1.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-mosaic-component": "^7.0.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.harebrowser.app",
    "productName": "Hare Browser",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Hare-Browser-Setup-${version}.${ext}"
    },
    "appx": {
      "applicationId": "HareBrowser",
      "identityName": "Franquette.HareBrowser",
      "publisher": "CN=B49C3D6A-5F00-415C-A291-F423E2F180AA",
      "publisherDisplayName": "Franquette"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hare Browser",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hare Browser",
      "include": "build/installer.nsh"
    },
    "files": [
      "**/*",
      "!out/**/*",
      "!dist/**/*",
      "!bin/**/*",
      "!ollama-bundle/**/*",
      "!searxng/**/*"
    ]
  }
}
